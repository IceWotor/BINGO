                text_size: self.width, None
<MANUAL>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"
            
            # Back Button
            Button:
                id: manualBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos

        FloatLayout:
            FloatLayout:
                orientation: "vertical"
                size_hint: 0.95, 0.97
                pos_hint: {"center_x": 0.5, "y": 0.043}

                canvas.before:
                    Color:
                        rgba: 0.0471, 0, 0.1294, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Image:
                    source: "./assets/pageAssets/manual/background.png"
                    size_hint: 1, None
                    height: self.width * (735/380)
                    pos_hint:{"center_x":0.5, "center_y":0.55}

                #Terms
                FloatLayout:
                    size_hint_y: None
                    pos_hint: {"center_x": 0.5, "center_y": 0.868}
                    height: "80dp"

                    Image:
                        source: "./assets/pageAssets/manual/termLabel.png"
                        size_hint: None, None
                        width: "50dp"
                        pos_hint: {"x": 0.13, "center_y": 1}
                    
                    Image:
                        source: "./assets/pageAssets/manual/termInput.png"
                        size_hint: 0.87, None
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    
                    TextInput:
                        id: termInput
                        size_hint: 0.7, None
                        height: dp(45)

                        font_name: "./assets/fonts/PixelifySans.ttf"
                        font_size: "14sp"
                        foreground_color: 0, 0, 0, 1
                        cursor_color: 0, 0, 0, 1

                        hint_text: "Primary Key"
                        hint_text_color: 0, 0, 0, 0.3

                        background_color: 0, 0, 0, 0
                        pos_hint: {"center_x": 0.5, "center_y": 0.4}

                
                #Definition
                FloatLayout:
                    size_hint_y: None
                    pos_hint: {"center_x": 0.5, "center_y": 0.568}
                    height: "195dp"

                    Image:
                        source: "./assets/pageAssets/manual/definitionLabel.png"
                        size_hint: None, None
                        width: "100dp"
                        pos_hint: {"x": 0.13, "center_y": 1.25}
                    
                    Image:
                        source: "./assets/pageAssets/manual/definitionInput.png"
                        size_hint: 1, 0.9
                        pos_hint: {"center_x": 0.5, "center_y": 0.8}

                    TextInput:
                        id: definitionInput
                        size_hint: 0.7, None
                        height: dp(120)
                        
                        font_name: "./assets/fonts/PixelifySans.ttf"
                        font_size: "16sp"
                        foreground_color: 0, 0, 0, 1
                        cursor_color: 0, 0, 0, 1

                        hint_text: "A field that uniquely identifies each record in the table. It is unique and cannot have duplicated values. An example of this is |"
                        hint_text_color: 0, 0, 0, 0.3
                        multiline: True

                        background_color: 1, 0, 0, 0
                        pos_hint: {"center_x": 0.5, "center_y": 0.8}
                
                # Add Terms
                Button:
                    id: addTermButton
                    size_hint: 0.63, None
                    height: self.width * ( 71 / 232 )

                    background_normal: "./assets/pageAssets/manual/addTermButton.png"
                    background_down: "./assets/pageAssets/manual/addTermButton.png"
                    
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                
                Image:
                    source: "./assets/pageAssets/manual/divider.png"
                    size_hint: 0.8, None
                    height: self.width * (3/323)
                    pos_hint: {"center_x": 0.5, "center_y": 0.44}
                
                Image:
                    source: "./assets/pageAssets/manual/currentEntries.png"
                    size_hint: 0.7, None
                    height: self.width * (33/36)
                    pos_hint: {"center_x": 0.5, "y": 0.24}

                Image:
                    source: "./assets/pageAssets/manual/entriesBorder.png"
                    size_hint: 0.8, None
                    height: self.width * (150/292)
                    pos_hint: {"center_x": 0.5, "center_y": 0.28}
                ScrollView:
                    size_hint: 0.75, 0.2
                    pos_hint: {"x": 0.12, "center_y": 0.28}    
                    bar_width: dp(0)


                    GridLayout:
                        id: entriesContainer
                        cols: 1
                        spacing: dp(8)
                        padding: dp(5)
                        size_hint_y: None
                        height: self.minimum_height
                        bar_width: dp(0)


                Label:
                    id: entryCountLabel
                    text: "0"
                    font_name: "./assets/fonts/PressStart2P.ttf"
                    font_size: "12sp"
                    pos_hint: {"x":0.302, "center_y":0.41}
                
                Button:
                    id: continueButton
                    size_hint: 0.89, None
                    height: self.width * ( 70 / 344 )
                    pos_hint: {"center_x": 0.5, "center_y":0.08}
                    background_normal: "./assets/pageAssets/manual/continueButton.png"
                    background_down: "./assets/pageAssets/manual/continueButton.png"

<GoBackPopup>:
    size_hint: 1, 1

    # POPUP BACKGROUND
    Image:
        source: "./assets/pageAssets/manual/popup/popupBackground.png"

        size_hint: 1.2, None
        height: self.width * 169 / 360

        pos_hint:
            {"center_x": 0.5, "center_y": 0.5}

        allow_stretch: True
        keep_ratio: False

    # LEAVE
    Button:
        id: leaveButton

        background_normal: "./assets/pageAssets/manual/popup/leaveButton.png"
        background_down: "./assets/pageAssets/manual/popup/leaveButton.png"
        border: 0, 0, 0, 0

        size_hint: 0.42, None
        height: self.width * 66 / 128

        pos_hint:
            {"center_x": 0.27, "center_y": 0.2}

    # STAY
    Button:
        id: stayButton

        background_normal: "./assets/pageAssets/manual/popup/stayButton.png"
        background_down: "./assets/pageAssets/manual/popup/stayButton.png"
        border: 0, 0, 0, 0

        size_hint: 0.42, None
        height: self.width * 44 / 130

        pos_hint:
            {"center_x": 0.73, "center_y": 0.2}


<CONTENTREVIEW>
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"

            # Back Button
            Button:
                id: conRevBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos

        FloatLayout:
            TextInput:
                id: reviewSetName
                size_hint: 0.8, None
                height: dp(42)

                font_name: "./assets/fonts/PressStart2P.ttf"
                font_size: "16sp"
                foreground_color: 1, 1, 1, 1
                cursor_color: 0, 0, 0, 1
                halign: "left"


                hint_text: "ENTER SETNAME"
                hint_text_color: 1, 1, 1, 0.5

                background_color: 0, 0, 0, 0
                pos_hint: {"center_x": 0.44, "center_y": 0.96}
            
            Button:
                id: edit_button
                size_hint: 0.2, None
                height: self.width * 26 / 92
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.745, "center_y": 0.97}

                Image:
                    source: "./assets/pageAssets/contentreview/editButton.png"
                    size: self.parent.size
                    pos: self.parent.pos
            
            Image:
                source:"./assets/pageAssets/contentreview/setContainer.png"
                size_hint: .9, None
                height: self.width * (589/373)
                allow_stretch: "true"
                pos_hint: {"center_x": 0.5, "center_y": 0.55}

            
            ScrollView:
                size_hint: 0.82, 0.75
                pos_hint: {"center_x": 0.5, "center_y": 0.55}
                bar_width: dp(0)

                GridLayout:
                    id: contentEntriesContainer
                    cols: 1
                    spacing: dp(8)
                    padding: dp(5)
                    size_hint_y: None
                    height: self.minimum_height
            
            Button:
                id: addTermButton
                size_hint: 0.59, None
                height: self.width * ( 71 / 232 )

                background_normal: "./assets/pageAssets/contentreview/addTermButton.png"
                background_down: "./assets/pageAssets/contentreview/addTermButton.png"
                
                pos_hint: {"center_x": 0.5, "center_y": 0.22}
            
            Button:
                id: completeReviewerButton
                size_hint: 0.89, None
                height: self.width * ( 70 / 344 )

                background_normal: "./assets/pageAssets/contentreview/completeReviewerButton.png"
                background_down: "./assets/pageAssets/contentreview/completeReviewerButton.png"
                
                pos_hint: {"center_x": 0.5, "center_y":0.12}

<REVIEWSETS>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"

            Button:
                id: reviewSetsBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos

        FloatLayout:

                
            Image:
                source: "./assets/pageAssets/contentreview/setContainer.png"
                size_hint: 0.9, None
                height: self.width * (589/373)
                allow_stretch: True
                pos_hint: {"center_x": 0.5, "center_y": 0.58}

            ScrollView:
                size_hint: 0.82, 0.85
                pos_hint: {"center_x": 0.5, "center_y": 0.52}
                bar_width: dp(0)

                GridLayout:
                    id: reviewSetsContainer
                    cols: 1
                    spacing: dp(8)
                    padding: dp(5)
                    size_hint_y: None
                    height: self.minimum_height
            Label:
                text: "REVIEW SETS"
                font_size: "22sp"
                color: 1, 1, 1, 1
                font_name: "./assets/fonts/PressStart2P.ttf"
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_x": 0.5, "center_y": 1}


        





        


        