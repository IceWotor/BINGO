<HOME>:
    BoxLayout:
        orientation: "vertical"

        Widget:
            size_hint_y: None
            height: self.width / 3.7

            FloatLayout:
                size: self.parent.size
                pos: self.parent.pos

                Image:
                    source: "./assets/pageAssets/home/homeDesign/gradientBackground.png"
                    size_hint_x: 1
                    size_hint_y: None
                    width: self.parent.width
                    height: self.texture_size[1] * (self.width / self.texture_size[0])
                    keep_ratio: True
                    pos_hint: {"x": 0, "center_y": -3}

                Image:
                    source: "./assets/pageAssets/home/homeDesign/subtleRay.png"
                    size_hint_x: 1
                    size_hint_y: None
                    width: self.parent.width
                    height: self.texture_size[1] * (self.width / self.texture_size[0])
                    keep_ratio: True
                    pos_hint: {"x": 0, "center_y": -1}



        #BINGO Title
        Image:
            source: "./assets/pageAssets/home/BINGO.png"
            size_hint_y: None
            height: self.width / 1.6
            allow_stretch: True
            keep_ratio: True
        
        Widget:
            size_hint_y: None
            height: self.width / 2.6
            
            FloatLayout:
                size: self.parent.size
                pos: self.parent.pos

                Image:
                    source: "./assets/pageAssets/home/homeBottom/overlay_stars.png"
                    size_hint_x: 1
                    size_hint_y: None
                    width: self.parent.width
                    height: self.texture_size[1] * (self.width / self.texture_size[0])
                    keep_ratio: True
                    pos_hint: {"x": 0, "center_y": -1.358}

                Image:
                    source: "./assets/pageAssets/home/homeBottom/checkered.png"
                    size_hint_x: 1
                    size_hint_y: None
                    width: self.parent.width
                    height: self.texture_size[1] * (self.width / self.texture_size[0])
                    keep_ratio: True
                    pos_hint: {"x": 0, "y": -2.2}

        BoxLayout:
            orientation: "vertical"
            spacing: 20
            
            # ScanButton
            Button:
                id: scanAcademicMaterial_button
                size_hint_x: 0.86
                size_hint_y: None
                height: self.width / 3.9
                pos_hint: {"center_x": 0.5}
                background_normal: "./assets/pageAssets/home/buttons/buttonDesign/scanButtonRectangle.png"
                background_down: "./assets/pageAssets/home/buttons/buttonDesign/scanButtonRectangle_Pressed.png"

                FloatLayout:
                    size: self.parent.size
                    pos: self.parent.pos

                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonIcons/camera.png"
                        size_hint: None, None
                        size: "50dp", "50dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.07, "center_y": 0.52}

                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonText/scanAcademicMaterial.png"
                        size_hint: None, None
                        size: "175dp", "175dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.285, "center_y": 0.63}

                    Label:
                        text: "Scan or upload your notes and study \nmaterials"
                        font_size: "9sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PixelifySans.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.29, "center_y": 0.38}
                    
                    Label:
                        text: ">"
                        font_size: "13sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PressStart2P.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.9, "center_y": 0.5}



            #ManualButton
            Button:
                id: manualEncoding_button
                size_hint_x: 0.86
                size_hint_y: None
                height: self.width / 3.9
                pos_hint: {"center_x": 0.5}
                background_normal: "./assets/pageAssets/home/buttons/buttonDesign/manualButtonRectangle.png"
                background_down: "./assets/pageAssets/home/buttons/buttonDesign/manualButtonRectangle_Pressed.png"
                
                FloatLayout:
                    size: self.parent.size
                    pos: self.parent.pos

                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonIcons/pencil.png"
                        size_hint: None, None
                        size: "67dp", "67dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.035, "center_y": 0.52}

                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonText/manualEncoding.png"
                        size_hint: None, None
                        size: "115dp", "115dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.285, "center_y": 0.58}

                    Label:
                        text: "Enter terms and define manually"
                        font_size: "9sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PixelifySans.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.29, "center_y": 0.44}
                    
                    Label:
                        text: ">"
                        font_size: "13sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PressStart2P.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.9, "center_y": 0.5} 

            #ReviewSetsButton
            Button:
                id: ReviewSets_button
                size_hint_x: 0.86
                size_hint_y: None
                height: self.width / 3.9
                pos_hint: {"center_x": 0.5}
                background_normal: "./assets/pageAssets/home/buttons/buttonDesign/reviewButtonRectangle.png"
                background_down: "./assets/pageAssets/home/buttons/buttonDesign/reviewButtonRectangle_Pressed.png"

                FloatLayout:
                    size: self.parent.size
                    pos: self.parent.pos

                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonIcons/folder.png"
                        size_hint: None, None
                        size: "65dp", "65dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.037, "center_y": 0.52}
                    
                    Image:
                        source: "./assets/pageAssets/home/buttons/buttonText/myReviewSets.png"
                        size_hint: None, None
                        size: "115dp", "115dp"
                        keep_ratio: True
                        pos_hint: {"x": 0.285, "center_y": 0.58}

                    Label:
                        text: "View and manage your saved review sets"
                        font_size: "9sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PixelifySans.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.29, "center_y": 0.44}
                    
                    Label:
                        text: ">"
                        font_size: "13sp"
                        color: 0, 0, 0, 1
                        font_name: "./assets/fonts/PressStart2P.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"x": 0.9, "center_y": 0.5}
            
        FloatLayout:
            size: self.parent.size
            pos: self.parent.pos

            Image:
                source: "./assets/pageAssets/home/homeBottom/ball41.png"
                size_hint: None, None
                size: "75dp", "75dp"
                keep_ratio: True
                pos_hint: {"x": 0.037, "center_y": 0.44}

            Image:
                source: "./assets/pageAssets/home/homeBottom/books.png"
                size_hint: None, None
                size: "88dp", "88dp"
                keep_ratio: True
                pos_hint: {"x": 0.72, "center_y": 0.44}
            
            Button:
                size_hint: None, None
                size: "150dp", "30dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.4}

                background_normal: "./assets/pageAssets/home/buttons/buttonDesign/idkButtonRectangle.png"
                background_down: "./assets/pageAssets/home/buttons/buttonDesign/idkButtonRectangle_Pressed.png"

                FloatLayout:
                    size: self.parent.size
                    pos: self.parent.pos

                    Label:
                        text: "Group 4"
                        font_size: "6sp"
                        font_name: "./assets/fonts/PressStart2P.ttf"
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"center_x": 0.5, "center_y": 0.6}

            
            Image:
                source: "./assets/pageAssets/home/homeDesign/cat1.png"
                size_hint: None, None
                size: "75dp", "75dp"
                keep_ratio: True
                pos_hint: {"center_x": 0.5, "center_y": 2.99}

<SCAN>
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"
            
            # Back Button
            Button:
                id: scanBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos
        FloatLayout:
            FloatLayout:
                orientation: "vertical"
                size_hint: 0.95, 0.97
                pos_hint: {"center_x": 0.5, "y": 0.043}

                canvas.before:
                    Rectangle:
                        source: "./assets/images/general/purpleBigBackground.png"
                        pos: self.pos
                        size: self.size

                FloatLayout:
                    Image:
                        source: "./assets/pageAssets/scan/provideMaterial.png"
                        size_hint: 0.6, None
                        height: self.width * (159/225)
                        pos_hint: {"center_x": 0.53, "center_y": 0.87}
                    Button:
                        id: cameraButton
                        size_hint: 0.75, None
                        height: self.width * (132/298)
                        pos_hint: {"center_x": 0.53, "center_y": 0.65}
                        background_normal: "./assets/pageAssets/scan/cameraButton.png"
                        background_down: "./assets/pageAssets/scan/cameraButton.png"
                    Image:
                        source: "./assets/pageAssets/scan/or.png"
                        size_hint: 0.6, None
                        height: self.width * (159/225)
                        pos_hint: {"center_x": 0.53, "center_y": 0.54}
                    Button:
                        id: uploadButton
                        size_hint: 0.75, None
                        height: self.width * (132/298)
                        pos_hint: {"center_x": 0.53, "center_y": 0.44}
                        background_normal: "./assets/pageAssets/scan/uploadButton.png"
                        background_down: "./assets/pageAssets/scan/uploadButton.png"
                    Image:
                        source: "./assets/pageAssets/scan/supported.png"
                        size_hint: 0.6, None
                        height: self.width * (159/225)
                        pos_hint: {"center_x": 0.53, "center_y": 0.33}






<CAMERASCAN>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"
            
            # Back Button
            Button:
                id: camerascanBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos
        FloatLayout:
            FloatLayout:
                orientation: "vertical"
                size_hint: 0.95, 0.97
                pos_hint: {"center_x": 0.5, "y": 0.043}



                CameraWidget:
                    canvas.before:
                        Color:
                            rgba: 0.047, 0, 0.129, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                            
                    id: camera
                    size_hint: 0.95, None
                    height: self.width * 16 / 9
                    pos_hint: {"center_x": 0.502, "y": 0.08}

                Image:
                    source: "./assets/pageAssets/camerascan/cameraBorder.png"
                    size_hint: 1.04, None
                    height: self.width * 16 / 9
                    fit_mode: "fill"
                    pos_hint: {"center_x": 0.5, "center_y": 0.52}

                Button:
                    id: takephoto
                    text: ""
                    size_hint: 0.25, 0.25
                    pos_hint: {"center_x": 0.5, "y": 0.02}
                    background_color: 0, 0, 0, 0


                    Image:
                        source: "./assets/pageAssets/camerascan/takePhotoButton.png"
                        size: self.parent.size
                        pos: self.parent.pos


<IMAGEPREVIEW>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Widget:
            size_hint_y: None
            height: "50dp"

        FloatLayout:
            size_hint_y: None
            height: "40dp"
            
            # Back Button
            Button:
                id: photoBackButton
                size_hint: None, None
                size: dp(60), dp(60)
                background_color: 0, 0, 0, 0
                pos_hint: {"x": 0.05, "center_y": 0.5}

                Image:
                    source: "./assets/icons/backButton.png"
                    size: self.parent.size
                    pos: self.parent.pos
        FloatLayout:
            orientation: "vertical"
            Image:
                id: preview_image
                size_hint: 0.76, None
                height: self.width * (16/9)
                fit_mode: "contain"
                pos_hint: {"center_x":0.5, "center_y":0.62}

            Image:
                source: "./assets/pageAssets/imagepreview/cameraBorder.png"
                size_hint: 0.83, None
                height: self.width * 16 / 9
                fit_mode: "fill"
                pos_hint: {"center_x": 0.5, "center_y": 0.62}


            Button:
                id: usePhotoButton
                text: ""
                size_hint: 0.48, None
                height: self.width * 9 / 16
                background_color: 0, 0, 0, 0
                pos_hint: {"center_x": 0.72, "y": 0.1}

                Image:
                    source:"./assets/pageAssets/imagepreview/useImage.png"
                    size: self.parent.size
                    pos: self.parent.pos

            Button:
                id: retakeButton
                text: ""
                size_hint: 0.4, None
                height: self.width * 9 / 16
                background_color: 0, 0, 0, 0
                pos_hint: {"center_x": 0.25, "y": 0.11}

                Image:
                    source:"./assets/pageAssets/imagepreview/retakeButton.png"
                    size: self.parent.size
                    pos: self.parent.pos


<TEXTPREVIEW>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.047, 0, 0.129, 1
